{
  "manifest_version": 3,
  "name": "Daily Tracker",
  "version": "0.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "daily-tracker@manya.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "128": "icon.png"
  }
}
